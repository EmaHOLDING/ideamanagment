# Fikir Kuluçkası — ortam değişkenleri örneği
#
# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldurun.
# GERÇEK DEĞER YAZMAYIN — bu dosya git'e dahildir, `.env.local` değildir.
#
#   cp .env.example .env.local
#
# Canlıya çıkarken aynı anahtarları barındırma platformunun ortam
# değişkenleri panelinden girmeniz gerekir.

# =========================================================
# Supabase — ZORUNLU
# Supabase panel > Project Settings > API
# =========================================================
# Projenin API adresi (yerel geliştirmede: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# "anon public" anahtarı. Tarayıcıya gönderilir; gizli değildir,
# yetkilendirme RLS politikalarıyla sağlanır.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" anahtarı. RLS'i tamamen bypass eder — ASLA tarayıcıya
# sızmamalı, yalnızca sunucu tarafında (bildirim üretimi vb.) kullanılır.
SUPABASE_SERVICE_ROLE_KEY=

# =========================================================
# Uygulama adresi — ZORUNLU
# E-postalardaki bağlantılar bu adrese göre üretilir.
# Yerelde: http://localhost:3000 · Canlıda: https://alanadiniz.com
# =========================================================
NEXT_PUBLIC_APP_URL=

# =========================================================
# Kimlik doğrulama sağlayıcıları
# Bu değerler Supabase Auth panelinde de tanımlanır; buradakiler
# yerel geliştirme (supabase/config.toml) içindir.
#
# Şu an arayüzde YALNIZCA Google aktif. Diğerleri kod seviyesinde
# hazır ama gizli — açmak isterseniz doldurun.
# =========================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Aşağıdakiler opsiyonel (arayüzde şu an kapalı) ---
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_URL=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_URL=

# =========================================================
# E-posta gönderimi (Resend) — OPSİYONEL
# Boş bırakılırsa uygulama çalışmaya devam eder, sadece bildirim
# e-postaları gönderilmez.
# =========================================================
RESEND_API_KEY=
# Gönderen adresi. Resend'de doğrulanmış bir alan adı olmalı.
# Örn: Fikir Kuluçkası <bildirim@alanadiniz.com>
EMAIL_FROM=

# =========================================================
# Hata izleme — OPSİYONEL (ama canlıda şiddetle önerilir)
# =========================================================
# Sunucu hataları bu adrese e-posta olarak gönderilir.
# Aynı hata için saatte en fazla 1 mail gönderilir (sel baskını olmaz).
# Boş bırakılırsa hatalar yalnızca sunucu loguna yazılır
# (`[error-report]` etiketiyle aranabilir).
ERROR_ALERT_EMAIL=
# Ek/alternatif kanal: Slack Incoming Webhook URL'si veya kendi
# toplayıcınız. Gövde hem Slack (`text`) hem genel toplayıcılar
# (`detail`) tarafından okunabilecek şekilde gönderilir.
ERROR_WEBHOOK_URL=
